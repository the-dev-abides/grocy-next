{
  "name": "@grocy-next/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "api",
    "tags": [
      "scope:api",
      "type:app"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "web"
            ],
            "target": "build"
          }
        ]
      },
      "serve": {
        "executor": "@nx/js:node",
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2"
  }
}
