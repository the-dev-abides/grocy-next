{
  "name": "@grocy-next/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "api",
    "tags": [
      "scope:api",
      "type:app"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "web"
            ],
            "target": "build"
          }
        ]
      },
      "serve": {
        "executor": "@nx/js:node",
        "continuous": true,
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        }
      },
      "openapi": {
        "command": "DB_FILE=:memory: GROCY_URL=http://grocy.invalid GROCY_API_KEY=placeholder TS_NODE_PROJECT=tsconfig.app.json node --import @swc-node/register/esm-register src/write-openapi.ts && pnpm exec prettier --write openapi.json",
        "options": {
          "cwd": "apps/api"
        },
        "outputs": [
          "{projectRoot}/openapi.json"
        ]
      }
    }
  },
  "dependencies": {
    "@grocy-next/inventory-products": "workspace:*",
    "@grocy-next/inventory-review-queue": "workspace:*",
    "@grocy-next/shared-next-api": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/mcp": "^0.0.4",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^1.21.0",
    "better-sqlite3": "^13.0.3",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@nestjs/testing": "^12.3.2"
  }
}
