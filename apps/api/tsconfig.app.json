{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/api",
    "types": ["node"],
    "rootDir": "src",
    "emitDeclarationOnly": false,
    "rewriteRelativeImportExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "tsBuildInfoFile": "out-tsc/api/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/inventory/products/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/next-api/tsconfig.lib.json"
    }
  ]
}
