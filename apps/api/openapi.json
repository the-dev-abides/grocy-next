                }
              }
            },
            "description": "The request fails the schema"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "Delete one pending scan.",
        "tags": ["PendingScans"]
      }
    }
