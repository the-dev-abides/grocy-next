  "info": {
    "title": "Grocy Next API",
    "description": "The Next API of Grocy Next.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "FieldError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "What is wrong with the field."
          },
          "path": {
            "type": "string",
            "description": "The dotted path of the field."
          }
        },
        "required": ["message", "path"],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "description": "What went wrong in this one request."
          },
          "errors": {
            "description": "The field errors of a validation problem.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "instance": {
            "type": "string",
            "description": "The request path."
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The HTTP status of the response."
          },
          "title": {
            "type": "string",
            "description": "The fixed title of the type."
          },
          "type": {
            "type": "string",
            "description": "The stable URI of the cause."
          }
        },
        "required": ["detail", "instance", "status", "title", "type"],
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "description": {
            "description": "The description of the product, or null when it has none.",
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the product."
          },
          "name": {
            "type": "string",
            "description": "The name of the product."
          }
        },
        "required": ["description", "id", "name"],
        "additionalProperties": false
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "description": "Every product."
          }
        },
        "required": ["items"],
        "additionalProperties": false
      }
    }
  }
}
