  "info": {
    "title": "Grocy Next API",
    "description": "The Next API of Grocy Next.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "FieldError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "What is wrong with the field."
          },
          "path": {
            "type": "string",
            "description": "The dotted path of the field."
          }
        },
        "required": ["message", "path"],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string",
            "description": "What went wrong in this one request."
          },
          "errors": {
            "description": "The field errors of a validation problem.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "instance": {
            "type": "string",
            "description": "The request path."
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The HTTP status of the response."
          },
          "title": {
            "type": "string",
            "description": "The fixed title of the type."
          },
          "type": {
            "type": "string",
            "description": "The stable URI of the cause."
          }
        },
        "required": ["detail", "instance", "status", "title", "type"],
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "description": {
            "description": "The description of the product, or null when it has none.",
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the product."
          },
          "name": {
            "type": "string",
            "description": "The name of the product."
          }
        },
        "required": ["description", "id", "name"],
        "additionalProperties": false
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "description": "Every product."
          }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "CreatePendingScan": {
        "type": "object",
        "properties": {
          "amount": {
            "description": "The amount.",
            "type": "number"
          },
          "bookingType": {
            "type": "string",
            "enum": ["inventory", "purchase"],
            "description": "The booking that the accept makes."
          },
          "code": {
            "description": "The code as scanned or typed.",
            "type": "string",
            "minLength": 1
          },
          "dueDate": {
            "description": "The due date.",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "locationId": {
            "description": "The id of the location.",
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          },
          "note": {
            "description": "The note.",
            "type": "string"
          },
          "price": {
            "description": "The price as entered.",
            "type": "number"
          },
          "priceType": {
            "description": "Whether the price is per unit or in total.",
            "type": "string",
            "enum": ["total", "unit"]
          },
          "productGroupId": {
            "description": "The id of the product group of a new product.",
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          },
          "productId": {
            "description": "The id of the product.",
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          },
          "quantityUnitId": {
            "description": "The id of the quantity unit of the amount. Purchase only.",
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          },
          "storeId": {
            "description": "The id of the store.",
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          },
          "writeInName": {
            "description": "The product name that the user typed on the scan screen.",
            "type": "string"
          }
        },
        "required": ["bookingType"],
        "additionalProperties": false
      },
      "LookupResult": {
        "type": "object",
        "properties": {
          "brand": {
            "description": "The brand.",
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "description": "The URL of the front image.",
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "The product name."
          },
          "netQuantity": {
            "description": "The net quantity in the net quantity unit.",
            "type": "number",
            "nullable": true
          },
          "netQuantityUnit": {
            "description": "The unit of the net quantity, g or ml.",
            "type": "string",
            "nullable": true
          },
          "quantityText": {
            "description": "The quantity text as printed on the label.",
            "type": "string",
            "nullable": true
          },
          "service": {
            "type": "string",
            "description": "The name of the service that held the product."
          },
          "sourceUrl": {
            "type": "string",
            "description": "The URL of the product page, for the attribution."
          }
        },
        "required": [
          "brand",
          "imageUrl",
          "name",
          "netQuantity",
          "netQuantityUnit",
          "quantityText",
          "service",
          "sourceUrl"
        ],
        "additionalProperties": false
      },
      "PendingScan": {
        "type": "object",
        "properties": {
          "amount": {
            "description": "The amount. Purchase: in the unit quantityUnitId, or the purchase unit of the product. Inventory: the new own stock in the stock unit.",
            "type": "number",
            "nullable": true
          },
          "bookingType": {
            "type": "string",
            "enum": ["inventory", "purchase"],
            "description": "The booking that the accept makes."
          },
          "code": {
            "description": "The code as scanned or typed, or null for a row from the assistant.",
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "The time of the create, in UTC."
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "The due date, or null for the Grocy product default.",
            "nullable": true
          },
          "error": {
            "description": "The Grocy message of the last failed accept, or null.",
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the pending scan."
          },
          "lastLookupAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "The time of the last lookup attempt, in UTC, or null.",
            "nullable": true
          },
          "locationId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the location.",
            "nullable": true
          },
          "lookupResult": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LookupResult"
              }
            ],
            "nullable": true,
            "description": "The lookup result, or null."
          },
          "note": {
            "description": "The note.",
            "type": "string",
            "nullable": true
          },
          "price": {
            "description": "The price as entered.",
            "type": "number",
            "nullable": true
          },
          "priceType": {
            "type": "string",
            "enum": ["total", "unit"],
            "description": "Whether the price is per unit or in total."
          },
          "productBarcodeId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the product barcode that an update added in Grocy, or null.",
            "nullable": true
          },
          "productGroupId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the product group of a new product.",
            "nullable": true
          },
          "productId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the product, or null.",
            "nullable": true
          },
          "quantityUnitId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the quantity unit of the amount. Purchase only.",
            "nullable": true
          },
          "scannedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "The time of the scan, in UTC."
          },
          "storeId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The id of the store.",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "The time of the last change, in UTC."
          },
          "writeInName": {
            "description": "The product name that the user typed on the scan screen.",
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "amount",
          "bookingType",
          "code",
          "createdAt",
          "dueDate",
          "error",
          "id",
          "lastLookupAt",
          "locationId",
          "lookupResult",
          "note",
          "price",
          "priceType",
          "productBarcodeId",
          "productGroupId",
          "productId",
          "quantityUnitId",
          "scannedAt",
          "storeId",
          "updatedAt",
          "writeInName"
        ],
        "additionalProperties": false
      },
      "PendingScanList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PendingScan"
            },
            "description": "Every pending scan, most recent first."
          }
        },
        "required": ["items"],
        "additionalProperties": false
      }
    }
  }
}
