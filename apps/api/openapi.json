    "/api/v2/pending-scans": {
      "post": {
        "operationId": "createPendingScan",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePendingScan"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The stored pending scan.",
            "headers": {
              "Location": {
                "description": "The path of the new pending scan.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingScan"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request fails the schema"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not JSON"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Grocy is unavailable"
          }
        },
        "summary": "Create a pending scan.",
        "tags": ["PendingScans"]
      },
      "get": {
        "operationId": "listPendingScans",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every pending scan, most recent first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingScanList"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request fails the schema"
          }
        },
        "summary": "List every pending scan.",
        "tags": ["PendingScans"]
      }
    },
    "/api/v2/pending-scans/{id}": {
      "get": {
        "operationId": "getPendingScan",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The id of the pending scan.",
            "schema": {
              "maximum": 9007199254740991,
              "exclusiveMinimum": true,
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The pending scan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingScan"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request fails the schema"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "Read one pending scan.",
        "tags": ["PendingScans"]
      },
      "delete": {
        "operationId": "deletePendingScan",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The id of the pending scan.",
            "schema": {
              "maximum": 9007199254740991,
              "exclusiveMinimum": true,
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The pending scan as it was before the delete.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingScan"
                }
              }
            }
          },
          "400": {
            "content": {
