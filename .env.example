# Copy this file to `.env`. The API reads `.env` from the workspace root at
# start. Values that you set in the shell win over this file. With no edit,
# this file points the API at the bundled instances of `compose.dev.yaml`.

# The storage. `DB_ENGINE` is `sqlite` or `postgres`. Unset means `sqlite`.
# The SQLite engine reads `DB_FILE`. The folder must exist. The default is
# `/data/grocy-next.db`, which fits the container and not a developer host.
DB_ENGINE=sqlite
DB_FILE=./grocy-next.db

# The PostgreSQL engine reads these five variables when `DB_ENGINE` is
# `postgres`. The port default is 5432. The values below match the bundled
# PostgreSQL of `compose.dev.yaml`, which also reads them from `.env`. Set
# `DB_ENGINE=postgres` and start the `postgres` profile to use it.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grocy-next
DB_USER=grocy-next
DB_PASSWORD=grocy-next

# The Grocy instance. `GROCY_URL` is the address of the Grocy instance.
# `GROCY_API_KEY` is an API key from the Grocy "Manage API keys" page. The
# process exits at start when one of the two is missing. The values below
# point at the bundled Grocy of `compose.dev.yaml`. It runs in demo mode and
# accepts any API key.
GROCY_URL=http://localhost:9283
GROCY_API_KEY=demo
