{
  "permissions": {
    "allow": [
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh api repos/the-dev-abides/grocy-next/issues:*)",
      "Bash(gh api --method POST repos/the-dev-abides/grocy-next/issues:*)",
      "Bash(git worktree:*)",
      "Bash(git push -u origin research/:*)",
      "Bash(git push origin research/:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/checks/src/pre-tool-use.mjs\""
          }
        ]
      }
    ]
  }
}
